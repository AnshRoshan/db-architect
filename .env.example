# ─────────────────────────────────────────────────────────────────────────────
# DB Architect — environment configuration
#
# Copy to `.env.local` and fill in. `.env.local` is git-ignored.
#   cp .env.example .env.local
#
# Everything except DATABASE_URL is optional. With no DATABASE_URL the app
# still boots and the landing page demo workspace works; live connections,
# sign-in and workspaces need it.
# ─────────────────────────────────────────────────────────────────────────────

# Application database (PostgreSQL). The schema is bootstrapped automatically on
# first use - you do not need to run drizzle-kit push.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/db_architect

# Secret used to seal connection credentials with AES-256-GCM.
# In production set this to a dedicated, managed secret. It falls back to a
# digest of DATABASE_URL when unset, which is only acceptable for local dev.
# DB_ARCHITECT_SECRET=change-me-to-a-long-random-value

# Comma-separated hosts that may be reached by live introspection despite the
# SSRF guard (metadata, loopback and private ranges are blocked by default).
# The application's own database is always treated as trusted.
# DB_ARCHITECT_HOST_ALLOWLIST=10.0.0.5,db.internal.example.com

# ── Optional: provider-backed AI assistant ────────────────────────────────────
# Without these, the assistant answers from the built-in rule-grounded
# generator. With them, the same grounded context is sent to the provider and
# the model id is shown in the UI verbatim.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# OPENAI_API_KEY=
# OPENAI_MODEL=
