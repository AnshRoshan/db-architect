{
  "name": "db-architect",
  "version": "0.1.0",
  "private": true,
  "description": "Database-agnostic architecture intelligence: introspect every schema, map every datastore, and turn real structure into evidence-backed findings, reviewable migrations and cross-engine transformation plans.",
  "license": "MIT",
  "author": {
    "name": "Ansh Roshan",
    "email": "ianshroshan@gmail.com",
    "url": "https://github.com/AnshRoshan"
  },
  "homepage": "https://github.com/AnshRoshan/db-architect#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnshRoshan/db-architect.git"
  },
  "bugs": {
    "url": "https://github.com/AnshRoshan/db-architect/issues"
  },
  "keywords": [
    "database",
    "schema",
    "introspection",
    "architecture",
    "erd",
    "migration",
    "postgres",
    "mysql",
    "mongodb",
    "redis",
    "nextjs"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "bun run lint && bun run typecheck && bun run test",
    "e2e": "node e2e/architecture.e2e.mjs",
    "e2e:auth": "node e2e/auth.e2e.mjs",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "elkjs": "^0.9.3",
    "framer-motion": "^14.12.0",
    "ioredis": "^6.0.0",
    "js-yaml": "^5.5.0",
    "lucide-react": "^1.71.0",
    "mongodb": "^7.8.0",
    "mysql2": "^3.24.6",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.5",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "postcss": "8.5.8",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
